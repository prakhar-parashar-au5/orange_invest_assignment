# Names and safe defaults only. Every VITE_* value is inlined into the public bundle,
# so nothing secret ever goes here.
#
# VITE_API_URL:
#   unset in `npm run dev` → http://localhost:4100
#   empty (VITE_API_URL=)  → same origin, requests go to relative /api/... (deploy behind one host)
#   unset in a build       → same origin as well
VITE_API_URL=http://localhost:4100
