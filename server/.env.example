# Reference list of the server's env vars. This file is OPTIONAL and nothing loads it: v1 uses no
# .env file. Locally every variable has a default that points at the Docker MySQL from
# `npm run db:up`. Pass real values on the start command (and later as Railway variables), e.g.
#   OPENAI_API_KEY=... npm start
# In production (NODE_ENV=production), startup fails if any variable marked "required in prod" is unset.

# runtime
NODE_ENV=
PORT=
CLIENT_ORIGIN=

# MySQL: the app pool and the agent's SELECT-only pool (both required in prod)
DATABASE_URL=
DATABASE_READONLY_URL=

# session signing (required in prod)
JWT_SECRET=

# LLM (the key is required in prod; the model has a default)
OPENAI_API_KEY=
OPENAI_MODEL=

# logging: info (default) or debug (adds agent tool names and timings)
LOG_LEVEL=
